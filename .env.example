# Copy this file to .env and set values only for sources you use.
SALES_API_URL=
SALES_API_TIMEOUT_SECONDS=30

# Optional source database connection URL, for example:
# postgresql+psycopg2://user:password@localhost:5432/retail_source
POSTGRES_SOURCE_URL=
POSTGRES_SOURCE_QUERY=SELECT * FROM orders

# Optional target PostgreSQL warehouse. Apply the scripts under sql/ first.
WAREHOUSE_DATABASE_URL=
